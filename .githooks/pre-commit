#!/usr/bin/env bash
# pre-commit：擋下含控制字元的暫存檔案（AGENTS.md 第 16 條）。
# 起因：用非原始字串寫入含反斜線的路徑時，\t 變成 Tab、\a 變成 BEL、\0 變成 NUL，
# 檔案看起來正常、內容卻被弄壞。只檢查「這顆 commit 暫存的內容」，不掃整個 repo。
# 規則：
#   - 所有文字檔：不得有 0x00–0x08、0x0B、0x0C、0x0E–0x1F、0x7F（\n、\r、Tab 除外）。
#   - 文件檔 .md：另外不得有 Tab（文件裡的 Tab 幾乎都是 \t 被吃掉的結果）。
#   - 文字副檔名的檔案不得含 NUL（否則 git 會當成二進位而略過檢查）。
# 無輸出 = 通過。回歸規格：bash .githooks/test-pre-commit.sh
set -u
export LC_ALL=C
cd "$(git rev-parse --show-toplevel)" || exit 1

paths=()
while IFS= read -r -d '' p; do paths+=("$p"); done < <(git diff --cached --name-only --diff-filter=ACM -z)
[ "${#paths[@]}" -eq 0 ] && exit 0

problems=""
add() { problems+="$1"$'\n'; }
g() { git --literal-pathspecs grep --cached -I -n -P "$@"; }

# 1) 控制字元（-I 略過真正的二進位檔）
while IFS= read -r hit; do
  add "  ${hit%%:*}:$(printf '%s' "${hit#*:}" | cut -d: -f1)  控制字元：$(printf '%s' "${hit#*:}" | cut -d: -f2- | cat -v | cut -c1-80)"
done < <(g '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' -- "${paths[@]}" 2>/dev/null | grep -v '^$')

# 2) .md 裡的 Tab
md=()
for p in "${paths[@]}"; do case "$p" in *.md) md+=("$p");; esac; done
if [ "${#md[@]}" -gt 0 ]; then
  while IFS= read -r hit; do
    add "  ${hit%%:*}:$(printf '%s' "${hit#*:}" | cut -d: -f1)  文件裡出現 Tab（多半是 \t 被吃掉）"
  done < <(g '\t' -- "${md[@]}" 2>/dev/null)
fi

# 3) 文字副檔名但含 NUL
for p in "${paths[@]}"; do
  case "$p" in
    *.md|*.ts|*.tsx|*.js|*.mjs|*.cjs|*.json|*.rs|*.toml|*.sh|*.html|*.css|*.yml|*.yaml|*.txt)
      total=$(git show ":$p" | wc -c)
      clean=$(git show ":$p" | tr -d '\000' | wc -c)
      [ "$total" != "$clean" ] && add "  $p  含 NUL 字元（$((total - clean)) 個）"
      ;;
  esac
done

if [ -n "$problems" ]; then
  {
    echo "commit 被擋下：暫存的檔案含有控制字元（AGENTS.md 第 16 條）。"
    printf '%s' "$problems"
    echo "多半是寫入含反斜線的路徑時 \t、\a、\0 被當成跳脫字元。路徑改用正斜線，或用原始字串重寫。"
    echo "修好後重新 git add 再 commit。"
  } >&2
  exit 1
fi
exit 0
