        "frontend": { "label": "使用者看到的畫面" },
        "messagebus": { "label": "狀態文字區的錯誤回饋" },
        "cloud": { "label": "待決（SRS 未定，不補結果）" }
      }
    }
  },
  "lanes": [
    { "id": "flow", "label": "訪客操作與規則判定" },
