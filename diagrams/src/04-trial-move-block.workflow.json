  "cards": [
    {
      "dot": "amber",
      "title": "SRS 邊界例子",
      "items": [
        "10:00–12:00 移到 13:00–15:00：合法，貼齊 15:00",
        "10:00–12:00 移到 13:30–15:30：無效，超出 15:00，恢復原位（AC-01.3d）",
        "縮短後的 10:00–10:30 移到 14:30–15:00：合法（AC-01.7）；最晚起始 13:00 只適用新建",
        "10:00–10:30 移到 15:00–15:30：無效，超出 15:00"
      ]
    }
