{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "試用：拖曳移動既有區塊（FR-04）",
    "locale": "zh-TW",
    "quality_profile": "showcase",
    "output": "diagrams/04-trial-move-block.html",
    "legend": {
      "entries": {
        "external": { "label": "訪客的輸入" },
        "security": { "label": "SRS 已定義的規則判定" },
