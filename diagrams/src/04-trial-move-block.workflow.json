  "nodes": [
    { "id": "start", "lane": "flow", "col": 0, "type": "external", "icon": "start", "label": "FR-04 拖曳區塊本體", "sublabel": "長度不變" },
    { "id": "round", "lane": "flow", "col": 1, "type": "cloud", "icon": "waiting", "label": "OR-01 取整到 30 分", "sublabel": "規則待決" },
    { "id": "check", "lane": "flow", "col": 2, "type": "security", "icon": "decision", "label": "FR-04 新位置合法？", "sublabel": "完整在 10:00–15:00" },
    { "id": "apply", "lane": "flow", "col": 3, "type": "backend", "label": "AC-01.7 套用新位置", "sublabel": "13:00 限制不適用" },
    { "id": "seen", "lane": "flow", "col": 4, "type": "frontend", "icon": "success", "label": "AC-01.7 區塊在新位置", "sublabel": "長度不變" },
    { "id": "reject", "lane": "invalid", "col": 2, "type": "backend", "icon": "failure", "label": "AC-01.3d 不生效", "sublabel": "恢復原位" },
    { "id": "msg", "lane": "invalid", "col": 3, "type": "messagebus", "label": "FR-04 狀態文字區", "sublabel": "顯示具體原因" },
    { "id": "p13", "lane": "pending", "col": 3, "type": "cloud", "icon": "waiting", "label": "OR-13 訊息文案時機", "sublabel": "中英文字・何時清除" }
  ],
  "edges": [
    { "id": "e1", "from": "start", "to": "round", "variant": "default" },
    { "id": "e2", "from": "round", "to": "check", "variant": "default" },
    { "id": "e3", "from": "check", "to": "apply", "label": "合法", "variant": "emphasis" },
    { "id": "e4", "from": "apply", "to": "seen", "variant": "emphasis" },
    { "id": "e5", "from": "check", "to": "reject", "label": "無效", "variant": "security", "role": "error" },
    { "id": "e6", "from": "reject", "to": "msg", "variant": "security", "role": "error" },
    { "id": "e7", "from": "msg", "to": "p13", "variant": "dashed", "role": "branch" }
