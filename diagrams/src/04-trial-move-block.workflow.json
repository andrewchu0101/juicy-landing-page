  "mainPath": ["start", "round", "check", "apply", "seen"],
  "semanticChecks": {
    "allowedRoots": ["start"],
    "allowedTerminals": ["seen", "p13"],
    "requiredEdges": [{ "from": "check", "to": "reject" }]
